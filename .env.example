# Ports the gateway opens on 127.0.0.1. Pick any two free ones.
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_PASSWORD=change-me
APP_PORT=8000
APP_URL=http://localhost:8000
OIDC_ISSUER=http://localhost:8080/realms/vardhan
OIDC_CLIENT_ID=kb-app
OIDC_CLIENT_SECRET_FILE=secrets/oidc_client_secret     # sso/setup_realm.py writes it

# Primary model: any OpenAI-compatible cloud API. Leave LLM_PRIMARY_BASE_URL empty to run fully local.
LLM_PRIMARY_BASE_URL=https://api.anthropic.com/v1/
LLM_PRIMARY_MODEL=claude-sonnet-5-5
LLM_PRIMARY_API_KEY_FILE=secrets/llm_primary_api_key   # one line, the key only
# Fallback: the open-weight model on your own machine
LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
LLM_FALLBACK_MODEL=qwen2.5:7b

